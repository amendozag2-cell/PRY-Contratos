# Copie este archivo como .env y cambie los valores. NUNCA suba el .env a GitHub.

# --- PostgreSQL (contenedor Docker)
POSTGRES_USER=contratos
POSTGRES_PASSWORD=cambie_esta_clave
POSTGRES_DB=contratos_db

# --- Backend
# Desarrollo local (backend con uv run): la base está en localhost.
# Con Docker Compose esta línea se reemplaza automáticamente por el host "db".
# Si la contraseña tiene caracteres especiales (@ : / # %), escríbalos codificados (%40, %3A...).
DATABASE_URL=postgresql+psycopg://contratos:cambie_esta_clave@localhost:5432/contratos_db
# Texto aleatorio de al menos 32 caracteres (ej.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambie_este_secreto
OPENAI_API_KEY=sk-...
# Carpeta tessdata de Tesseract con el idioma español (solo para contratos escaneados)
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata